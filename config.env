# KernelSU Action -- build profile
#
# Values here are defaults; workflow_dispatch inputs override them per run.
# Only the exact string "true" (or yes/on/1) counts as enabled.
#
# Copy this file to config/<device>.env to keep one profile per device, then
# pick it with the "Config file to build" input when you start a build.

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/icalasli/kernel_xiaomi_msm8953-4.9
KERNEL_SOURCE_BRANCH=lineage-17.1
KERNEL_CONFIG=mido_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# Optional: overrides the device label used in artifact names and sets
# CONFIG_LOCALVERSION. Leave blank to derive it from KERNEL_CONFIG.
KERNEL_NAME=

ADD_LOCALVERSION_TO_FILENAME=false

# Extra flags appended to every make invocation. Values may contain "=".
# DIHAPUS LD=ld.lld KARENA KITA PAKAI GCC SEKARANG
EXTRA_CMDS=KCFLAGS=-Wno-error
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# DIKOSONGKAN UNTUK MEMAKSA SISTEM MENGGUNAKAN GCC
CLANG_BRANCH=
CLANG_VERSION=

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# Build fully with LLVM (LLVM=1 LLVM_IAS=1). Good for 5.10+, usually breaks 4.x.
USE_LLVM=false

# ===================================================================== GCC ==
# DIAKTIFKAN UNTUK KERNEL 4.9
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

# SukiSU Ultra builtin adalah cara paling stabil untuk kernel 4.9
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin

# Wajib 'manual' untuk kernel 4.9 agar root berfungsi
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

# DIKOSONGKAN/FALSE karena SukiSU builtin sudah punya SUSFS bawaan
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# Wajib true untuk kernel 4.9 agar unmount berjalan lancar
ENABLE_PATH_UMOUNT=true

ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
