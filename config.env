# KernelSU Action -- build profile

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/icalasli/kernel_xiaomi_msm8953-4.9
KERNEL_SOURCE_BRANCH=lineage-17.1
KERNEL_CONFIG=mido_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# Menggunakan MAKEFLAGS agar variabel diteruskan ke seluruh sub-make
EXTRA_CMDS=KCFLAGS="-Wno-error"
CUSTOM_CMDS=MAKEFLAGS="CLANG_TRIPLE=aarch64-linux-android-"

# =================================================================== Clang ==
# DIKOSONGKAN UNTUK MEMAKSA SISTEM MENGGUNAKAN GCC
CLANG_BRANCH=
CLANG_VERSION=

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=CONFIG_CC_STACKPROTECTOR_STRONG=n

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
